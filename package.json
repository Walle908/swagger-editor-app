{
  "name": "swagger-editor-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "validate-branch": "validate-branch-name"
  },
  "lint-staged": {
    "*.{ts,js,jsx,tsx}": [
      "tsc --noEmit --skipLibCheck",
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "validate-branch-name": {
    "pattern": "^[0-9]+-(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)-[a-z0-9-]+$",
    "errorMsg": "Branch name must follow pattern: <issue-number>-<type>-<description>. Example: 4-chore-add-project-configs"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "9.16.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "typescript": "^5",
    "typescript-eslint": "^8.62.0",
    "validate-branch-name": "^1.3.2"
  }
}
